generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Household {
  id                 String              @id @default(cuid())
  name               String
  users              User[]
  goals              Goal[]
  monthCloses        MonthClose[]
  recurringTemplates RecurringTemplate[]
  settings           Setting[]
  planningDocument   PlanningDocument?
  pluggyItems        PluggyItem[]
  pjReceipts         PjReceipt[]
  pjRetainers        PjRetainer[]
  pjTaxRate          Float?              @default(6.0)
  createdAt          DateTime            @default(now())
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("member") // admin | member
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  creditCards  CreditCard[]
  pjReceipts   PjReceipt[]
  pluggyItems  PluggyItem[]

  @@index([householdId])
}

model Transaction {
  id                 String              @id @default(cuid())
  date               DateTime
  competencia        String // YYYY-MM (mês de competência)
  description        String
  category           String
  amount             Float // sempre positivo
  type               String // income | expense | transfer
  ownership          String // mine | partner | joint
  isSecret           Boolean             @default(false) // oculta do parceiro
  isRecurring        Boolean             @default(false)
  recurringId        String? // agrupa recorrentes
  installmentCurrent Int? // parcela atual (1, 2, 3...)
  installmentTotal   Int? // total de parcelas
  parentId           String? // ID da transação original (parcelas)
  source             String? // manual | csv_inter | ofx | recurring
  cardStatementId    String?
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  cardStatement      CardStatement?      @relation(fields: [cardStatementId], references: [id])
  pjReceipt          PjReceipt?
  pluggyImports      PluggyTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([competencia])
  @@index([userId])
  @@index([ownership])
  @@index([parentId])
}

model CreditCard {
  id             String          @id @default(cuid())
  name           String // "Inter", "Nubank", etc.
  bank           String
  closingDay     Int // dia de fechamento da fatura
  dueDay         Int // dia de vencimento
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  statements     CardStatement[]
  pluggyAccounts PluggyAccount[]
  createdAt      DateTime        @default(now())
}

model CardStatement {
  id           String        @id @default(cuid())
  cardId       String
  competencia  String // YYYY-MM
  totalAmount  Float
  status       String        @default("open") // open | paid
  card         CreditCard    @relation(fields: [cardId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@unique([cardId, competencia])
}

model PluggyItem {
  id              String          @id @default(cuid())
  pluggyItemId    String          @unique
  connectorId     Int?
  connectorName   String?
  status          String?
  executionStatus String?
  errorCode       String?
  errorMessage    String?
  lastUpdatedAt   DateTime?
  lastSyncedAt    DateTime?
  raw             Json?
  householdId     String
  household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  accounts        PluggyAccount[]
  syncLogs        PluggySyncLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([householdId])
  @@index([userId])
  @@index([status])
}

model PluggyAccount {
  id                 String              @id @default(cuid())
  pluggyAccountId    String              @unique
  pluggyItemId       String
  item               PluggyItem          @relation(fields: [pluggyItemId], references: [pluggyItemId], onDelete: Cascade)
  type               String
  subtype            String?
  name               String
  marketingName      String?
  number             String?
  owner              String?
  currencyCode       String?
  balance            Float?
  creditLimit        Float?
  linkedCreditCardId String?
  linkedCreditCard   CreditCard?         @relation(fields: [linkedCreditCardId], references: [id], onDelete: SetNull)
  raw                Json?
  transactions       PluggyTransaction[]
  bills              PluggyBill[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([pluggyItemId])
  @@index([linkedCreditCardId])
  @@index([type])
}

model PluggyBill {
  id              String        @id @default(cuid())
  pluggyBillId    String        @unique
  pluggyAccountId String
  account         PluggyAccount @relation(fields: [pluggyAccountId], references: [pluggyAccountId], onDelete: Cascade)
  dueDate         DateTime?
  closeDate       DateTime?
  totalAmount     Float?
  minimumPayment  Float?
  status          String?
  raw             Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([pluggyAccountId])
  @@index([dueDate])
}

model PluggyTransaction {
  id                    String        @id @default(cuid())
  pluggyTransactionId   String        @unique
  pluggyAccountId       String
  account               PluggyAccount @relation(fields: [pluggyAccountId], references: [pluggyAccountId], onDelete: Cascade)
  importedTransactionId String?
  importedTransaction   Transaction?  @relation(fields: [importedTransactionId], references: [id])
  date                  DateTime
  description           String
  amount                Float
  type                  String?
  status                String?
  category              String?
  categoryId            String?
  merchantName          String?
  paymentData           Json?
  creditCardMetadata    Json?
  raw                   Json?
  suggestedType         String?
  suggestedCategory     String?
  suggestedCompetencia  String?
  duplicateReason       String?
  ignoredAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([pluggyAccountId])
  @@index([date])
  @@index([importedTransactionId])
  @@index([ignoredAt])
}

model PluggySyncLog {
  id              String      @id @default(cuid())
  pluggyItemId    String?
  item            PluggyItem? @relation(fields: [pluggyItemId], references: [pluggyItemId], onDelete: SetNull)
  pluggyAccountId String?
  status          String
  message         String?
  startedAt       DateTime    @default(now())
  finishedAt      DateTime?
  createdAccounts Int         @default(0)
  createdBills    Int         @default(0)
  createdTxs      Int         @default(0)
  updatedTxs      Int         @default(0)

  @@index([pluggyItemId])
  @@index([pluggyAccountId])
  @@index([status])
}

model MonthClose {
  id             String    @id @default(cuid())
  competencia    String // YYYY-MM
  householdId    String
  household      Household @relation(fields: [householdId], references: [id])
  openingBalance Float
  totalIncome    Float
  totalExpense   Float
  metaAllocation Float     @default(0)
  closingBalance Float
  status         String    @default("open") // open | closed
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([householdId, competencia])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([householdId])
}

model RecurringTemplate {
  id          String  @id @default(cuid())
  description String
  category    String
  amount      Float
  type        String // income | expense
  ownership   String // mine | partner | joint
  dayOfMonth  Int // dia do mês para lançar
  startDate   String // YYYY-MM
  endDate     String? // YYYY-MM (null = indefinido)

  // Projection features
  interval      String  @default("monthly") // monthly | yearly
  intervalCount Int     @default(1)
  isVariable    Boolean @default(false)

  isActive    Boolean   @default(true)
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model Setting {
  id          String    @id @default(cuid())
  key         String
  value       String
  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, key])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
}

model PlanningDocument {
  id          String    @id @default(cuid())
  title       String    @default("Planejamento financeiro")
  content     String
  householdId String    @unique
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PjReceipt {
  id            String       @id @default(cuid())
  clientName    String
  description   String
  amount        Float
  dueDate       DateTime
  status        String       @default("unissued") // unissued, issued, pending, paid
  competencia   String // YYYY-MM
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  householdId   String
  household     Household    @relation(fields: [householdId], references: [id])
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  retainerId    String?
  retainer      PjRetainer?  @relation(fields: [retainerId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([householdId])
}

model PjRetainer {
  id          String   @id @default(cuid())
  householdId String
  clientName  String
  description String
  amount      Float
  dueDay      Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  receipts  PjReceipt[]

  @@index([householdId])
}
